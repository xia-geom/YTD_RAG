# math_rag is local-only by default.
# Future remote backends should be configured through environment variables,
# never by hard-coding secrets in source files.

MATH_RAG_INDEX_DIR=.math_rag_index
MATH_RAG_EMBEDDING_BACKEND=local
MATH_RAG_LOCAL_ONLY=true

# Remote read-only MCP over Streamable HTTP.
MATH_RAG_TOOL_MODE=chatgpt
MATH_RAG_AUTH_MODE=none
MATH_RAG_REMOTE_MCP_READ_ONLY=true
MATH_RAG_HOST=127.0.0.1
PORT=8000
MATH_RAG_REMOTE_TRANSPORT=streamable-http
MATH_RAG_REMOTE_PATH=/mcp
MATH_RAG_MCP_ALLOW_WRITE_TOOLS=false
MATH_RAG_ALLOW_UNAUTHENTICATED_PUBLIC=false
MATH_RAG_SEARCH_TOP_K=8
MATH_RAG_MAX_TOP_K=20
MATH_RAG_FETCH_MAX_CHARS=12000
MATH_RAG_PROTECT_HEALTH=false

# For bearer-protected local or deployed testing:
# MATH_RAG_AUTH_MODE=bearer
# MATH_RAG_API_TOKEN=replace-with-a-random-secret
# For private-index remote pilots, set MATH_RAG_PROTECT_HEALTH=true.
