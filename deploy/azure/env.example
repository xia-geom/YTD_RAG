# Placeholder runtime configuration for Azure remote MCP.
# Do not put secrets in this file.

MATH_RAG_INDEX_DIR=/data/.math_rag_index
MATH_RAG_AUTH_MODE=bearer
# Set this from Azure secrets or another secret store; never commit the real value.
MATH_RAG_API_TOKEN=secret-store-value-required
MATH_RAG_TOOL_MODE=chatgpt
MATH_RAG_REMOTE_MCP_READ_ONLY=true
MATH_RAG_HOST=0.0.0.0
PORT=8000
MATH_RAG_REMOTE_TRANSPORT=streamable-http
MATH_RAG_REMOTE_PATH=/mcp
MATH_RAG_SEARCH_TOP_K=8
MATH_RAG_MAX_TOP_K=20
MATH_RAG_FETCH_MAX_CHARS=12000
# Set true before mounting private index data so direct /healthz and /readyz
# require the backend bearer token too.
MATH_RAG_PROTECT_HEALTH=false

# Optional citation URL fallback for non-public sources.
# MATH_RAG_PUBLIC_BASE_URL=https://your-app.example.com

# Never enable this in remote deployments.
MATH_RAG_MCP_ALLOW_WRITE_TOOLS=false

# Keep public unauthenticated mode blocked.
MATH_RAG_ALLOW_UNAUTHENTICATED_PUBLIC=false
