{
  "$id": "agent_envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "message_id",
    "agent",
    "channel",
    "status",
    "created_at",
    "payload"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "message_id": { "type": "string" },
    "parent_message_id": { "type": ["string", "null"] },
    "agent": {
      "type": "string",
      "enum": [
        "researcher",
        "prompt_writer",
        "security_auditor",
        "test_runner",
        "synthesizer",
        "orchestrator"
      ]
    },
    "channel": {
      "type": "string",
      "enum": ["control", "artifact", "alert", "handoff", "result"]
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "passed", "failed", "blocked", "needs_input"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "high", "critical"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
